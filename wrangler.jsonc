{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "collective",
  "main": "crates/worker/build/index.js",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "cargo install -q worker-build --version 0.8.7 --locked && worker-build --release crates/worker"
  },
  "d1_databases": [
    // Create with `npx wrangler d1 create collective` and paste the id here.
    { "binding": "DB", "database_name": "collective", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "collective-blobs" }],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "ProjectCoordinator" },
      { "name": "PROOF", "class_name": "ProofRunner" }
    ]
  },
  // The proof sandbox: one container per proof (see docs/PROOFS.md).
  "containers": [
    { "class_name": "ProofRunner", "image": "./prover.Dockerfile", "max_instances": 5, "instance_type": "standard" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["ProofRunner"] }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put`, or .dev.vars locally):
  //   ADMIN_TOKEN          enables /v1/admin/* (canaries, pool funding, challenge resolution)
  //   REVIEW_SEED_SECRET   makes review task assignment unpredictable to reviewers
  //   GITHUB_CLIENT_ID     GitHub OAuth app (enable device flow on it); see docs/IDENTITY.md
  //   GITHUB_CLIENT_SECRET needed for the browser sign-in flow only
}
