{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collective",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    // Create with `npx wrangler d1 create collective` and paste the id here.
    { "binding": "DB", "database_name": "collective", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "collective-blobs" }],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT", "class_name": "ProjectCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectCoordinator"] }],
  "observability": { "enabled": true }
}
